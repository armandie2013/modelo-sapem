<section>
  <p class="muted">
    Se conservan las descripciones originales de los comprobantes ya emitidos.
  </p>

  <form
    data-producto-id="<%= registro._id %>"
    method="post"
    action="/inventario/registros/<%= tipoRegistro %>/<%= registro._id %>/editar"
  >
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input
      type="hidden"
      name="version"
      value="<%= registro.__v || 0 %>"
    >

    <% if (tipoRegistro === 'producto') { %>

      <%- include('camposProducto', {
        productoEditar: registro
      }) %>

      <%- include('similitudProducto') %>

    <% } else if (tipoRegistro === 'equipo') { %>

      <p>
        <b>Serie:</b> <%= registro.serie %>.
        Su ubicación y estado se modifican con movimientos de inventario.
      </p>

      <div class="grid">
        <label>
          MAC
          <input
            name="mac"
            value="<%= datos.mac ?? registro.mac ?? '' %>"
            maxlength="100"
          >
        </label>

        <label>
          Código patrimonial
          <input
            name="patrimonio"
            value="<%= datos.patrimonio ?? registro.patrimonio ?? '' %>"
            maxlength="100"
          >
        </label>
      </div>

    <% } else { %>

      <div class="grid">
        <label>
          Nombre
          <input
            name="nombre"
            value="<%= datos.nombre ?? registro.nombre %>"
            required
            maxlength="180"
          >
        </label>

        <label>
          Dirección
          <input
            name="direccion"
            value="<%= datos.direccion ?? registro.direccion ?? '' %>"
            maxlength="250"
          >
        </label>

        <label>
          Responsable
          <input
            name="responsable"
            value="<%= datos.responsable ?? registro.responsable ?? '' %>"
            maxlength="180"
          >
        </label>

        <label>
          DNI
          <input
            name="dni"
            value="<%= datos.dni ?? registro.dni ?? '' %>"
            maxlength="30"
          >
        </label>
      </div>

    <% } %>

    <div class="actions">
      <button type="submit">Guardar cambios</button>
      <a
        class="button secondary"
        href="/inventario/<%= seccion %>"
      >
        Cancelar
      </a>
    </div>
  </form>
</section>