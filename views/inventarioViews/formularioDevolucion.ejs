<%
  let anteriores = [];

  try {
    anteriores = JSON.parse(datos.items || '[]');
  } catch {}

  if (!Array.isArray(anteriores)) {
    anteriores = [];
  }

  const anterior = productoId =>
    anteriores.find(
      fila => String(fila.producto) === String(productoId)
    );
%>

<%- include('selectorSeries') %>
<section>
  <p>
    <b>Destinatario:</b>
    <%= mov.destinoNombre %>
  </p>

  <p>
    <b><%= mov.tipo === 'produccion' ? 'Puesta en producción original:' : 'Asignación original:' %></b>
    N.º <%= mov.numero %>
    · <%= fecha(mov.fecha) %>
  </p>

  <div class="actions">
    <a
      class="button secondary"
      href="/inventario/movimientos/<%= mov._id %>"
    >
      Consultar entrega original
    </a>
  </div>

  <% if (!pendientes.length) { %>
    <p>Esta asignación ya fue devuelta totalmente.</p>
  <% } else if (!depositos.length) { %>
    <p>Primero necesitás crear un depósito receptor.</p>
  <% } else { %>
    <form
      id="devolucion"
      method="post"
      action="/inventario/movimientos"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="accion" id="accionOperacion" value="confirmar">
      <input type="hidden" name="borradorId" value="<%= borradorId %>">
      <input type="hidden" name="borradorVersion" value="<%= borradorVersion %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="clave" value="<%= clave %>">
      <input type="hidden" name="tipo" value="devolucion">
      <input type="hidden" name="original" value="<%= mov._id %>">
      <input type="hidden" name="items" id="itemsDevolucion">

      <fieldset class="inv-paso">
        <legend>1. Material que regresa</legend>

        <%- include('buscadorMateriales', {
          buscadorId: 'buscarMaterialDevolucion',
          opcionesMateriales: pendientes.map(item => ({
            ...item,
            _id: String(item.producto)
          }))
        }) %>

        <p class="material-vacio" id="retornoVacio">
          Buscá y agregá los productos que te están devolviendo.
        </p>

        <% pendientes.forEach(item => {
          const previo = anterior(item.producto);

          const seleccionadas = new Set(
            String(previo?.series || '')
              .split(/\r?\n/)
              .map(serie => serie.trim().toUpperCase())
          );
        %>
          <fieldset
            class="retorno"
            hidden
            data-producto="<%= item.producto %>"
            data-serializado="<%= item.serializado ? 'si' : 'no' %>"
          >
            <legend>
              <%= item.nombre %>
              · pendientes:
              <%= n(item.cantidad - item.devuelto) %>
              <%= item.unidad %>
            </legend>

            <button
              type="button"
              class="material-quitar"
              title="Quitar artículo"
              aria-label="Quitar artículo"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6"/>
              </svg>
            </button>

            <div class="series-retorno">
              <% if (item.serializado) { %>
                <div class="series-devolucion" style="grid-column: 1 / -1">
                  <label>Cantidad
                    <input class="cantidadRetorno" type="number" min="0" step="1" value="0" readonly>
                  </label>
                  <div>Carga manual: una serie por línea
                    <textarea class="seriesManual" rows="3" aria-label="Series a devolver"><%= previo?.series || '' %></textarea>
                  </div>
                  <script type="application/json" class="equipos-retorno"><%- JSON.stringify(equiposPendientes.filter(e => String(e.producto) === String(item.producto))).replace(/</g, '\u003c') %></script>
                </div>
              <% } else { %>
                <label>
                  Cantidad a devolver
                  <input
                    class="cantidadRetorno"
                    type="number"
                    value="<%= previo?.cantidad || 0 %>"
                    min="0"
                    max="<%= (item.cantidad - item.devuelto) / 1000 %>"
                    step="1"
                  >
                </label>
              <% } %>
            </div>
          </fieldset>
        <% }); %>
      </fieldset>

      <fieldset class="inv-paso">
        <legend>2. Recepción de la devolución</legend>

        <div class="grid">
          <label>
            Fecha
            <input
              name="fecha"
              type="date"
              value="<%= datos.fecha || hoy %>"
              required
            >
          </label>

          <label>
            Depósito receptor
            <select name="destino" required>
              <% depositos.forEach(deposito => { %>
                <option
                  value="<%= deposito._id %>"
                  <%= String(deposito._id) === (datos.destino || principal)
                    ? 'selected' : '' %>
                >
                  <%= deposito.nombre %>
                </option>
              <% }); %>
            </select>
          </label>

          <label>
            Estado del material
            <select name="estadoRecepcion">
              <option value="disponible">Disponible</option>
              <option
                value="revision"
                <%= datos.estadoRecepcion === 'revision' ? 'selected' : '' %>
              >
                A revisar
              </option>
            </select>
          </label>

          <label>
            Persona que devuelve
            <input
              name="entrega"
              value="<%= datos.entrega || '' %>"
              required
              maxlength="180"
            >
          </label>

          <label>
            Persona que recibe
            <input
              name="recibe"
              value="<%= datos.recibe || '' %>"
              required
              maxlength="180"
            >
          </label>

          <label>
            DNI de quien recibe
            <input
              name="dniRecibe"
              value="<%= datos.dniRecibe || '' %>"
              maxlength="30"
            >
          </label>
        </div>

        <label>
          Observaciones
          <textarea
            name="observaciones"
            maxlength="4000"
          ><%= datos.observaciones || '' %></textarea>
        </label>

        <label>
          Adjuntos: hasta 3 PDF, PNG o JPG de 10 MB cada uno
          <input
            name="archivos"
            type="file"
            multiple
            accept="application/pdf,image/png,image/jpeg"
          >
        </label>
      </fieldset>

      <div class="actions">
        <button
          type="submit"
          formnovalidate
          data-accion="borrador"
          class="secondary"
        >
          Guardar borrador
        </button>

        <button type="submit" data-accion="confirmar">
          Confirmar devolución y generar acta
        </button>

        <a class="button secondary" href="/inventario/devoluciones">
          Cancelar
        </a>
      </div>
    </form>

    <script>
    (() => {
      const form = document.querySelector('#devolucion');
      const filas = [...form.querySelectorAll('.retorno')];
      const vacio = document.querySelector('#retornoVacio');

      const actualizar = () => {
        vacio.hidden = filas.some(fila => !fila.hidden);
      };

      const selectores = new Map();
      filas.forEach(fila => {
        const textarea = fila.querySelector('.seriesManual');
        if (textarea) {
          const equipos = JSON.parse(fila.querySelector('.equipos-retorno').textContent);
          selectores.set(fila, crearSelectorSeries({
            textarea, cantidad: fila.querySelector('.cantidadRetorno'),
            obtenerEquipos: () => equipos, claseCheckbox: 'serieRetorno'
          }));
        }
        const cantidad = fila.querySelector('.cantidadRetorno');

        fila.hidden = !(
          fila.querySelector('.serieRetorno:checked') ||
          Number(cantidad?.value) > 0
        );

        fila.querySelector('.material-quitar')
          .addEventListener('click', () => {
            fila.querySelectorAll('.serieRetorno')
              .forEach(checkbox => checkbox.checked = false);

            selectores.get(fila)?.limpiar();
            if (cantidad) cantidad.value = '0';

            fila.hidden = true;
            actualizar();
          });
      });

      actualizar();

      form.addEventListener('inventario:agregar', evento => {
        const fila = filas.find(
          fila => fila.dataset.producto === String(evento.detail._id)
        );

        if (!fila) return;

        fila.hidden = false;
        actualizar();

        fila.scrollIntoView({
          block: 'nearest',
          behavior: 'smooth'
        });

        fila.querySelector('.serieRetorno, .cantidadRetorno')?.focus();
      });

      form.addEventListener('submit', evento => {
        const guardar =
          evento.submitter?.dataset.accion === 'borrador';

        form.querySelector('[name="accion"]').value =
          guardar ? 'borrador' : 'confirmar';

        const items = filas
          .filter(fila => !fila.hidden)
          .map(fila => {
            const series = String(fila.querySelector('.seriesManual')?.value || '')
              .split(/\r?\n/).map(s => s.trim().toUpperCase()).filter(Boolean);

            return {
              producto: fila.dataset.producto,
              cantidad: fila.dataset.serializado === 'si'
                ? String(series.length)
                : fila.querySelector('.cantidadRetorno').value,
              series: series.join('\n')
            };
          })
          .filter(fila => Number(fila.cantidad) > 0);

        if (!guardar && !items.length) {
          evento.preventDefault();
          alert(
            'Agregá productos y seleccioná las series o cantidades a devolver.'
          );
          return;
        }

        if (
          !guardar &&
          !confirm('¿Confirmás que recibiste este material?')
        ) {
          evento.preventDefault();
          return;
        }

        form.querySelector('#itemsDevolucion').value =
          JSON.stringify(items);

        form.querySelectorAll('button[type="submit"]')
          .forEach(boton => boton.disabled = true);
      });
    })();
    </script>
  <% } %>
</section>

<%- include('adjuntosBorrador') %>