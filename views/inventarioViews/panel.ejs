<%
const n = valor =>
  ((valor || 0) / 1000).toLocaleString(
    'es-AR',
    { maximumFractionDigits: 3 }
  );

const fecha = valor =>
  new Date(valor).toLocaleDateString('es-AR', {
    timeZone: 'America/Argentina/Buenos_Aires'
  });

const pestanas = [
  ['general', '', 'General'],
  ['borradores', '/borradores', 'Borradores'],
  ['depositos', '/depositos', 'Depósitos'],
  ['equipos', '/equipos', 'Equipos'],
  ['ingresos', '/ingresos', 'Ingresos'],
  ['asignaciones', '/asignaciones', 'Asignaciones'],
  ['devoluciones', '/devoluciones', 'Devoluciones'],
  ['traspasos', '/traspasos', 'Traspasos'],
  ['productos', '/productos', 'Productos'],
  ['destinatarios', '/destinatarios', 'Destinatarios']
];
%>

<style>
  /* Alcance exclusivo del módulo inventario. Se conserva la paleta original. */
  main.container:has(> .inv) {
    max-width: 1600px;
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .inv { width: 100%; max-width: 1568px; margin: auto; font-size: 14px; line-height: 1.45; }
  .inv *, .inv *::before, .inv *::after { box-sizing: border-box; }
  .inv header { margin-bottom: 12px; }
  .inv header p { margin: 0 0 3px; }
  .inv h1 { font-size: 26px; font-weight: 800; line-height: 1.2; margin: 0; }
  .inv h2 { font-size: 18px; font-weight: 700; line-height: 1.3; margin: 0 0 10px; }
  .inv p { margin: 0 0 10px; }
  .inv .muted { color: #64748b; font-size: 13px; }
  .inv-tabs { display: flex; overflow-x: auto; gap: 5px; padding: 4px 0 8px; margin-bottom: 12px; }
  .inv-tabs a { display: inline-flex; align-items: center; flex: 0 0 auto; white-space: nowrap; min-height: 32px; padding: 6px 11px; border-radius: 5px; background: #e2e8f0; color: #334155; font-size: 13px; line-height: 20px; text-decoration: none; }
  .inv-tabs a[aria-current="page"] { color: white; background: #1e40af; }
  .inv section { min-width: 0; background: white; padding: 16px; margin-bottom: 12px; border: 1px solid #e2e8f0; border-radius: 8px; }
  .inv section:last-child { margin-bottom: 0; }
  .inv .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr)); gap: 10px 12px; }
  .inv .grid > * { min-width: 0; }
  .inv .actions { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin: 10px 0; }
  .inv .actions form { margin: 0; }
  .inv label { display: block; font-size: 13px; margin: 8px 0; }
  .inv .grid > label { margin: 0; }
  .inv input, .inv select, .inv textarea { width: 100%; min-width: 0; border: 1px solid #cbd5e1; border-radius: 5px; padding: 6px 9px; background: white; font: inherit; font-size: 14px; line-height: 20px; }
  .inv label > input:not([type="checkbox"]):not([type="hidden"]), .inv label > select, .inv label > textarea { margin-top: 3px; }
  .inv input[type="hidden"] { display: none; }
  .inv input[type="checkbox"], .inv input[type="radio"] { width: auto; min-height: 0; margin-right: 4px; vertical-align: middle; }
  .inv textarea { min-height: 68px; resize: vertical; }
  .inv input[type="file"] { padding: 5px 7px; }
  .inv button, .inv .button { display: inline-flex; justify-content: center; align-items: center; gap: 5px; min-height: 32px; max-width: 100%; border: 0; background: #1e40af; color: white; border-radius: 5px; padding: 6px 11px; font: inherit; font-size: 13px; font-weight: 500; line-height: 20px; text-align: center; text-decoration: none; cursor: pointer; }
  .inv button.secondary, .inv a.secondary { background: #e2e8f0; color: #334155; }
  .inv button:disabled { opacity: .5; cursor: wait; }
  .inv a:focus-visible, .inv button:focus-visible, .inv input:focus-visible, .inv select:focus-visible, .inv textarea:focus-visible, .inv summary:focus-visible { outline: 2px solid #1e40af; outline-offset: 2px; }
  .inv table { width: 100%; border-collapse: collapse; font-size: 14px; line-height: 1.4; }
  .inv td, .inv th { border-bottom: 1px solid #e2e8f0; padding: 9px 10px; text-align: left; vertical-align: middle; }
  .inv th { background: #eff6ff; font-size: 13px; font-weight: 700; white-space: nowrap; }
  .inv td a { color: #1e40af; text-decoration: underline; }
  .inv td a.button { color: white; text-decoration: none; }
  .inv td a.button.secondary { color: #334155; }
  .inv .scroll { max-width: 100%; overflow: auto; }
  .inv td .actions { margin: 0; gap: 5px; }
  .inv td .actions button, .inv td .actions .button { min-height: 28px; padding: 4px 8px; font-size: 12px; }
  .inv .aviso { padding: 10px 12px; margin-bottom: 12px; border-radius: 6px; background: #fff7ed; border: 1px solid #fdba74; }
  .inv .success { background: #f0fdf4; border-color: #86efac; }
  .inv fieldset { min-width: 0; border: 1px solid #e2e8f0; padding: 12px; margin: 12px 0; border-radius: 6px; }
  .inv legend { font-weight: 700; padding: 0 4px; }
  .inv .pagination { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding-top: 10px; }
  .inv .panel-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
  .inv .panel-heading > div:first-child { min-width: 0; }
  .inv .panel-heading h2 { margin-bottom: 5px; }
  .inv .panel-heading p { margin: 0; }
  .inv .panel-heading .actions { margin: 0; justify-content: flex-end; flex-shrink: 0; }
  .inv .stock-table th:nth-child(n+3), .inv .stock-table td:nth-child(n+3) { text-align: right; font-variant-numeric: tabular-nums; }
  .inv .stock-table td:last-child { font-weight: 700; }
  .inv .stock-table td[colspan] { text-align: left; font-weight: 400; }
  .inv .stock-table td:first-child { min-width: 220px; }
  .inv .grid + label, .inv .grid + .actions { margin-top: 10px; }
  .inv details > summary { font-size: 14px; }
  @media (max-width: 900px) {
    .inv .panel-heading { flex-wrap: wrap; }
    .inv .panel-heading .actions { justify-content: flex-start; flex-shrink: 1; }
  }
  @media (max-width: 640px) {
    main.container:has(> .inv) { padding: 16px 12px; }
    .inv h1 { font-size: 23px; }
    .inv section { padding: 12px; }
    .inv .grid { grid-template-columns: 1fr; }
    .inv-tabs a { min-height: 40px; }
    .inv button, .inv .button, .inv td .actions button, .inv td .actions .button { min-height: 40px; padding: 8px 10px; font-size: 13px; }
    .inv input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]), .inv select, .inv textarea { font-size: 16px; }
    .inv td, .inv th { padding: 8px; }
  }

  /* Reglas exclusivas de los listados; no rediseñan formularios internos. */
  .inv-list .list-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px 16px; margin-bottom: 14px; }
  .inv-list .list-heading p { margin: 0; max-width: 85ch; }
  .inv-list .list-heading .actions { margin: 0; }
  .inv-list .list-heading h2 { margin: 0 0 4px; }
  .inv-list .list-toolbar { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 8px 12px; margin: 0 0 14px; }
  .inv-list .list-toolbar label { flex: 0 1 230px; min-width: 150px; margin: 0; }
  .inv-list .list-toolbar .grid { display: contents; }
  .inv-list .list-toolbar .actions { margin: 0; }
  .inv-list .list-table { table-layout: auto; }
  .inv-list .list-table td { overflow-wrap: anywhere; }
  .inv-list .list-table th { padding-top: 10px; padding-bottom: 10px; }
  .inv-list .list-table td { padding-top: 11px; padding-bottom: 11px; }
  .inv-list .list-table tbody tr:hover { background: #eff6ff; }
  .inv-list .list-table .col-actions { width: 1%; white-space: nowrap; }
  .inv-list .row-actions { display: flex; align-items: center; gap: 5px; flex-wrap: nowrap; }
  .inv-list .row-actions form { margin: 0; }
  .inv-list .row-actions .button, .inv-list .row-actions button { min-height: 28px; padding: 4px 8px; font-size: 12px; line-height: 20px; white-space: nowrap; }
  .inv-list .row-actions .danger { background: #b91c1c; color: white; }
  .inv-list .cell-title { display: block; font-weight: 500; }
  .inv-list .cell-sub { display: block; margin-top: 3px; font-size: 12px; color: #64748b; }
  .inv-list .list-table .number { text-align: right; font-variant-numeric: tabular-nums; }
  .inv-list .list-table .nowrap { white-space: nowrap; }
  .inv-list .list-table .description { min-width: 160px; max-width: 320px; }
  .inv-list .list-table .product-name { min-width: 180px; }
  .inv-list .list-table .material { min-width: 200px; }
  .inv-list .list-table .empty { padding: 22px 12px; text-align: center; color: #64748b; font-weight: 400; }
  .inv-list .list-table .state { display: inline-block; font-size: 12px; font-weight: 500; padding: 3px 7px; border: 1px solid #e2e8f0; border-radius: 4px; white-space: nowrap; }
  .inv-list .list-footer { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; border-top: 1px solid #e2e8f0; padding-top: 10px; margin-top: 12px; color: #64748b; font-size: 13px; }
  .inv-list .list-footer .pagination { padding: 0; margin: 0; }
  @media (max-width: 640px) {
    .inv-list .list-heading { align-items: flex-start; }
    .inv-list .list-toolbar label { flex: 1 1 100%; min-width: 0; }
    .inv-list .row-actions .button, .inv-list .row-actions button { min-height: 40px; padding: 8px 10px; font-size: 13px; }
  }
</style>

<div class="inv <%= ['dashboard', 'borradores', 'lugares', 'equipos', 'movimientos', 'productos'].includes(vista) ? 'inv-list' : '' %>">
  <header>
    <p class="muted">Técnica / Inventario</p>
    <h1><%= titulo %></h1>
  </header>

  <nav
    class="inv-tabs"
    aria-label="Secciones de inventario"
  >
    <% pestanas.forEach(([id, ruta, etiqueta]) => { %>
      <a
        href="/inventario<%= ruta %>"
        <%- seccion === id
          ? 'aria-current="page"'
          : ''
        %>
      >
        <%= etiqueta %>
      </a>
    <% }) %>
  </nav>

  <% if (aviso) { %>
    <div
      class="aviso <%= aviso.ok ? 'success' : '' %>"
      role="alert"
    >
      <%= aviso.texto %>
    </div>
  <% } %>

  <%- include(vista, { n, fecha }) %>
</div>