<%
  const ingreso = tipo === 'ingreso';

  const origenes = lugares.filter(
    lugar => lugar.tipo === 'deposito'
  );

  const destinosPermitidos = lugares.filter(
    lugar => lugar.tipo === (
      ['asignacion', 'produccion'].includes(tipo) ? 'destino' : 'deposito'
    )
  );
%>

<%- include('productoDesdeDocumento', { ingreso }) %>
<%- include('selectorSeries') %>

<section>
  <% if (
    (!ingreso && !productos.length) ||
    !destinosPermitidos.length ||
    (!ingreso && !origenes.length)
  ) { %>
    <p>
      Antes de registrar esta operación necesitás productos
      y las ubicaciones correspondientes.
    </p>

    <div class="actions">
      <a class="button secondary" href="/inventario/productos">
        Productos
      </a>
      <a class="button secondary" href="/inventario/depositos">
        Depósitos
      </a>
      <a class="button secondary" href="/inventario/destinatarios">
        Destinatarios
      </a>
    </div>
  <% } else { %>
    <form
      id="movimiento"
      method="post"
      action="/inventario/movimientos"
      enctype="multipart/form-data"
    >
      <input type="hidden" name="accion" id="accionOperacion" value="confirmar">
      <input type="hidden" name="borradorId" value="<%= borradorId %>">
      <input type="hidden" name="borradorVersion" value="<%= borradorVersion %>">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input type="hidden" name="clave" value="<%= clave %>">
      <input type="hidden" name="tipo" value="<%= tipo %>">
      <input type="hidden" name="items" id="items">

      <% if (ingreso) { %>
        <fieldset class="inv-paso">
          <legend>1. Documento de ingreso</legend>

          <div class="grid">
            <label>
              Tipo de documento
              <select name="documentoTipo">
                <% ['remito', 'factura', 'nota', 'acta', 'otro']
                  .forEach(tipoDocumento => { %>
                  <option
                    value="<%= tipoDocumento %>"
                    <%= datos.documentoTipo === tipoDocumento ? 'selected' : '' %>
                  >
                    <%= tipoDocumento %>
                  </option>
                <% }); %>
              </select>
            </label>

            <label>
              Número (S/N si no tiene)
              <input
                name="documentoNumero"
                value="<%= datos.documentoNumero || '' %>"
                required
                maxlength="100"
              >
            </label>

            <label>
              Fecha del documento
              <input
                name="documentoFecha"
                type="date"
                value="<%= datos.documentoFecha || hoy %>"
                required
              >
            </label>

            <label>
              Emisor / proveedor
              <input
                name="emisor"
                value="<%= datos.emisor || '' %>"
                required
                maxlength="180"
              >
            </label>
          </div>

          <label>
            <input
              type="checkbox"
              name="documentoRepetido"
              value="si"
              <%= datos.documentoRepetido === 'si' ? 'checked' : '' %>
            >
            Este documento ya respalda otra recepción parcial;
            permitir reutilizarlo.
          </label>
        </fieldset>
      <% } %>

      <fieldset class="inv-paso">
        <legend>
          <%= ingreso
            ? '2. Material efectivamente recibido'
            : tipo === 'produccion' ? '1. Equipos a poner en producción' : '1. Artículos a entregar'
          %>
        </legend>

        <p class="muted">
          Podés seleccionar las series disponibles o ingresarlas manualmente, una por línea.
          En un ingreso podés completar SERIE | MAC | PATRIMONIO.
          Las cantidades deben ser enteras y coincidir con las series
          cuando corresponda.
        </p>

        <%- include('buscadorMateriales', {
          buscadorId: 'buscarMaterialMovimiento',
          opcionesMateriales: productos
        }) %>

        <p class="material-vacio" id="materialVacio">
          Todavía no agregaste artículos.
          Buscá un producto para comenzar.
        </p>

        <div class="scroll">
          <table class="material-table">
            <thead>
              <tr>
                <th>Producto</th>
                <th>Cantidad</th>
                <th>Series / identificación</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="filas"></tbody>
          </table>
        </div>
      </fieldset>

      <fieldset class="inv-paso">
        <legend>
          <%= ingreso
            ? '3. Recepción en depósito'
            : '2. Origen, destino y recepción'
          %>
        </legend>

        <% if (tipo === 'produccion') { %><p class="muted">La ubicación de instalación se elige del catálogo de <a href="/inventario/destinatarios">Destinatarios</a>. Podés registrar nodos, oficinas, escuelas u otros sitios con su dirección y responsable.</p><% } %>
        <div class="grid">
          <label>
            Fecha de recepción
            <input
              name="fecha"
              type="date"
              value="<%= datos.fecha || hoy %>"
              required
            >
          </label>

          <% if (!ingreso) { %>
            <label>
              Depósito de origen
              <select name="origen" required>
                <% origenes.forEach(lugar => { %>
                  <option
                    value="<%= lugar._id %>"
                    <%= String(lugar._id) === (datos.origen || principal)
                      ? 'selected' : '' %>
                  >
                    <%= lugar.nombre %>
                  </option>
                <% }); %>
              </select>
            </label>
          <% } %>

          <label>
            <%= ingreso ? 'Depósito receptor' : tipo === 'produccion' ? 'Ubicación de instalación' : 'Destino' %>
            <select name="destino" required>
              <% destinosPermitidos.forEach(lugar => { %>
                <option
                  value="<%= lugar._id %>"
                  <%= String(lugar._id) === (
                    datos.destino || (ingreso ? principal : '')
                  ) ? 'selected' : '' %>
                >
                  <%= lugar.nombre %>
                  <%= String(lugar._id) === principal ? ' (principal)' : '' %>
                </option>
              <% }); %>
            </select>
          </label>

          <label>
            Entrega
            <input
              name="entrega"
              value="<%= datos.entrega || '' %>"
              required
              maxlength="180"
            >
          </label>

          <label>
            Recibe
            <input
              name="recibe"
              value="<%= datos.recibe || '' %>"
              required
              maxlength="180"
            >
          </label>

          <label>
            DNI de quien recibe
            <input
              name="dniRecibe"
              value="<%= datos.dniRecibe || '' %>"
              maxlength="30"
            >
          </label>
        </div>

        <% if (ingreso && !principal) { %>
          <p class="muted">
            Todavía no hay un depósito principal definido.
            Seleccioná el receptor; un administrador puede marcar
            el principal desde Depósitos.
          </p>
        <% } %>

        <label>
          Observaciones / diferencias con el documento
          <textarea
            name="observaciones"
            maxlength="4000"
          ><%= datos.observaciones || '' %></textarea>
        </label>

        <label>
          Adjuntos opcionales: hasta 3 archivos PDF, PNG o JPG
          de 10 MB cada uno
          <input
            type="file"
            name="archivos"
            multiple
            accept="application/pdf,image/png,image/jpeg"
          >
        </label>
      </fieldset>

      <p class="muted">
        Confirmá cuando el material haya sido recibido.
        Se actualizarán las existencias y se generará el comprobante.
      </p>

      <div class="actions">
        <button
          type="submit"
          formnovalidate
          data-accion="borrador"
          class="secondary"
        >
          Guardar borrador
        </button>

        <button type="submit" data-accion="confirmar">
          Confirmar y generar comprobante
        </button>

        <a
          class="button secondary"
          href="/inventario/<%= config.ruta %>"
        >
          Cancelar
        </a>
      </div>
    </form>

    <script type="application/json" id="datosMovimiento"><%- JSON.stringify({
      productos,
      equiposDisponibles: typeof equiposDisponibles !== 'undefined' ? equiposDisponibles : [],
      ingreso,
      datos
    }).replace(/</g, '\u003c') %></script>

    <script>
    (() => {
      const { productos, datos, equiposDisponibles, ingreso } = JSON.parse(
        document.querySelector('#datosMovimiento').textContent
      );

      const form = document.querySelector('#movimiento');
      const filas = document.querySelector('#filas');
      const selectores = new Map();
      form.querySelector('[name=origen]')?.addEventListener('change', () => {
        selectores.forEach(selector => selector.refrescar());
      });

      function actualizarVacio() {
        document.querySelector('#materialVacio').hidden =
          !!filas.children.length;

        filas.closest('.scroll').hidden = !filas.children.length;
      }

      function agregar(fila = {}) {
        if (!fila.producto) return;

        const id = String(fila.producto);

        const existente = [...filas.children].find(
          tr => tr.dataset.producto === id
        );

        if (existente) {
          existente.querySelector('.cantidad').focus();
          return;
        }

        const producto = productos.find(
          p => String(p._id) === id
        );

        const tr = document.createElement('tr');
        tr.dataset.producto = id;

        tr.innerHTML = `
          <td>
            <input type="hidden" class="producto">
            <span class="material-identidad"></span>
            <span class="material-detalle"></span>
          </td>

          <td>
            <input
              class="cantidad"
              aria-label="Cantidad"
              type="number"
              min="1"
              step="1"
              required
            >
          </td>

          <td>
            <textarea
              class="series"
              aria-label="Números de serie"
              rows="3"
            ></textarea>
          </td>

          <td>
            <button
              type="button"
              class="material-quitar"
              title="Quitar artículo"
              aria-label="Quitar artículo"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6"/>
              </svg>
            </button>
          </td>
        `;

        tr.querySelector('.producto').value = id;

        tr.querySelector('.material-identidad').textContent = producto
          ? `${producto.codigo} · ${producto.nombre}`
          : 'Producto no disponible: quitá este renglón y seleccioná otro.';

        tr.querySelector('.material-detalle').textContent = producto
          ? [
              producto.marca,
              producto.modelo,
              producto.serializado
                ? 'Por número de serie'
                : 'Por cantidad'
            ].filter(Boolean).join(' · ')
          : '';

        const cantidad = tr.querySelector('.cantidad');
        cantidad.value = fila.cantidad ?? 1;

        cantidad.setCustomValidity(
          producto ? '' : 'Seleccioná un producto disponible.'
        );

        const series = tr.querySelector('.series');
        series.value = fila.series || '';
        series.disabled = !producto?.serializado;
        series.required = !!producto?.serializado;

        series.placeholder = producto?.serializado
          ? 'Una serie por línea'
          : 'Control por cantidad';

        if (producto?.serializado && !ingreso) {
          const etiqueta = document.createElement('span');
          etiqueta.className = 'material-detalle';
          etiqueta.textContent = 'Carga manual: una serie por línea (también admite lector).';
          series.before(etiqueta);
          selectores.set(id, crearSelectorSeries({
            textarea: series, cantidad,
            obtenerEquipos: () => equiposDisponibles.filter(equipo =>
              String(equipo.producto) === id &&
              String(equipo.lugar) === form.querySelector('[name=origen]').value
            )
          }));
        }

        tr.querySelector('.material-quitar').onclick = () => {
          selectores.delete(id);
          tr.remove();
          actualizarVacio();
        };

        filas.append(tr);
        actualizarVacio();

        return tr;
      }

      form.addEventListener('inventario:agregar', evento => {
        const tr = agregar({
          producto: String(evento.detail._id),
          cantidad: 1
        });

        tr?.querySelector('.cantidad').focus();
      });

      let anteriores = [];

      try {
        anteriores = JSON.parse(datos.items || '[]');
      } catch {}

      if (Array.isArray(anteriores)) {
        anteriores.forEach(agregar);
      }

      actualizarVacio();

      form.addEventListener('submit', evento => {
        const guardar =
          evento.submitter?.dataset.accion === 'borrador';

        form.querySelector('[name="accion"]').value =
          guardar ? 'borrador' : 'confirmar';

        const items = [...filas.querySelectorAll('tr')]
          .map(tr => ({
            producto: tr.querySelector('.producto').value,
            cantidad: tr.querySelector('.cantidad').value,
            series: tr.querySelector('.series').disabled
              ? ''
              : tr.querySelector('.series').value
          }));

        if (!guardar && !items.length) {
          evento.preventDefault();
          alert('Agregá al menos un artículo.');
          return;
        }

        if (
          !guardar &&
          !confirm('¿Confirmás la recepción y el movimiento de existencias?')
        ) {
          evento.preventDefault();
          return;
        }

        form.querySelector('#items').value = JSON.stringify(items);

        form.querySelectorAll('button[type="submit"]')
          .forEach(boton => boton.disabled = true);
      });
    })();
    </script>
  <% } %>
</section>

<%- include('adjuntosBorrador') %>