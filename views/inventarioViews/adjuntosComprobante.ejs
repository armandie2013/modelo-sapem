  <section class="web adjuntos">
    <div class="cabecera">
      <h2>Archivos adjuntos</h2>
      <span class="contador"><%= archivos.length %> <%= archivos.length === 1 ? 'archivo' : 'archivos' %></span>
    </div>

    <% archivos.forEach(adjunto => { %>
      <div class="archivo">
        <span class="archivo-nombre"><%= adjunto.nombre %></span>
        <div class="acciones">
          <a class="boton secondary" href="/inventario/archivos/<%= adjunto._id %>?ver=1" target="_blank" rel="noopener noreferrer" aria-label="Ver <%= adjunto.nombre %>">Ver</a>
          <a class="boton secondary" href="/inventario/archivos/<%= adjunto._id %>" aria-label="Descargar <%= adjunto.nombre %>">Descargar</a>
        </div>
      </div>
    <% }); %>
    <% if (!archivos.length) { %><p class="muted">No hay archivos adjuntos.</p><% } %>

    <% if (puedeAdjuntar) { %>
      <form class="subir pie-formulario" method="post" action="<%= rutaAdjuntos %>" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div>
          <label>Agregar copia firmada u otros adjuntos
            <input name="archivos" type="file" multiple required accept="application/pdf,image/png,image/jpeg">
          </label>
          <p class="muted">Hasta 3 archivos por envío · 10 MB por archivo.</p>
        </div>
        <button type="submit">Guardar adjuntos</button>
      </form>
    <% } %>
  </section>

