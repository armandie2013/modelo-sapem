<% if (ingreso && borradorId && permisos.administrar) { %>
  <section>
    <details>
      <summary style="cursor:pointer;font-weight:700">
        Crear una ficha que falta en el catálogo
      </summary>

      <p class="muted">
        Usá esta opción antes de completar la tabla.
        Se crea la ficha del catálogo y se agrega un renglón al ingreso
        pendiente; el stock se incorpora solamente al confirmar la recepción.
        Si ya modificaste renglones, guardá primero el borrador.
      </p>

      <form
        method="post"
        action="/inventario/ingresos/<%= borradorId %>/productos"
      >
        <input type="hidden" name="_csrf" value="<%= csrf %>">

        <%- include('camposProducto', {
          productoEditar: null
        }) %>

        <%- include('similitudProducto') %>

        <div class="actions">
          <button type="submit">
            Crear ficha y agregarla al ingreso
          </button>
        </div>
      </form>
    </details>
  </section>
<% } %>