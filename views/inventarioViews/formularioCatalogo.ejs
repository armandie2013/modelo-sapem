<section>
  <form method="post" action="/inventario/catalogos">
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <input
      type="hidden"
      name="catalogo"
      value="<%= tipoCatalogo === 'producto' ? 'producto' : 'lugar' %>"
    >

    <% if (tipoCatalogo === 'producto') { %>

      <%- include('camposProducto', {
        productoEditar: null
      }) %>

      <%- include('similitudProducto') %>

    <% } else { %>

      <input
        type="hidden"
        name="tipoLugar"
        value="<%= tipoCatalogo %>"
      >

      <div class="grid">
        <label>
          Nombre
          <input
            name="nombre"
            value="<%= datos.nombre || '' %>"
            required
            maxlength="180"
          >
        </label>

        <label>
          Dirección
          <input
            name="direccion"
            value="<%= datos.direccion || '' %>"
            maxlength="250"
          >
        </label>

        <label>
          Responsable
          <input
            name="responsable"
            value="<%= datos.responsable || '' %>"
            maxlength="180"
          >
        </label>

        <label>
          DNI del responsable
          <input
            name="dni"
            value="<%= datos.dni || '' %>"
            maxlength="30"
          >
        </label>
      </div>

      <% if (tipoCatalogo === 'deposito') { %>
        <label>
          <input
            type="checkbox"
            name="principal"
            value="si"
            <%= datos.principal === 'si' ? 'checked' : '' %>
          >
          Usar como depósito principal para los nuevos ingresos
        </label>
      <% } %>

    <% } %>

    <div class="actions">
      <button type="submit">Guardar</button>
      <a
        class="button secondary"
        href="/inventario/<%= seccion %>"
      >
        Cancelar
      </a>
    </div>
  </form>
</section>