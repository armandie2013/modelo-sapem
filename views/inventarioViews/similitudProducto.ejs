<div class="aviso-similitud" aria-live="polite"></div>
<label
  ><input type="checkbox" name="confirmarSimilar" value="si" /> Revisé las
  coincidencias y confirmo que es un producto distinto.</label
>
<script>
  (() => {
    const script = document.currentScript;
    const form = script.closest("form");
    if (!form) return;
    const aviso = form.querySelector(".aviso-similitud");
    let timer,
      consulta = 0;
    const buscar = () => {
      clearTimeout(timer);
      const turno = ++consulta;
      form.querySelector('[name="confirmarSimilar"]').checked = false;
      timer = setTimeout(async () => {
        const q = new URLSearchParams({
          nombre: form.elements.nombre.value,
          modelo: form.elements.modelo.value,
          excluir: form.dataset.productoId || "",
        });
        try {
          const respuesta = await fetch("/inventario/productos/similares?" + q);
          if (!respuesta.ok) throw new Error();
          const datos = await respuesta.json();
          if (turno !== consulta) return;
          aviso.replaceChildren();
          if (!datos.length) return;
          const p = document.createElement("p");
          p.textContent =
            "Hay productos similares. Revisalos antes de crear otra ficha:";
          aviso.append(p);
          datos.forEach((d) => {
            const a = document.createElement("a");
            a.href = "/inventario/productos";
            a.textContent = `${d.codigo} · ${d.nombre} ${d.marca || ""} ${d.modelo || ""}${d.activo === false ? " (inactivo)" : ""}`;
            aviso.append(a, document.createElement("br"));
          });
        } catch {
          if (turno === consulta)
            aviso.textContent =
              "La comprobación de coincidencias se realizará al guardar.";
        }
      }, 300);
    };
    ["nombre", "marca", "modelo"].forEach((n) =>
      form.elements[n].addEventListener("input", buscar),
    );
  })();
</script>
