<style>
  .inv .equipo-historial .evento-numero { width: 1%; white-space: nowrap; }
  .inv .equipo-cabecera { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .inv .equipo-cabecera h2 { margin: 0; font-size: 17px; line-height: 1.4; overflow-wrap: anywhere; }
  .inv .equipo-cabecera .actions { margin: 0; flex-shrink: 0; }
  .inv .equipo-datos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px 18px; margin: 0; }
  .inv .equipo-datos > div { min-width: 0; }
  .inv .equipo-datos dt { font-size: 12px; color: #64748b; margin-bottom: 2px; }
  .inv .equipo-datos dd { margin: 0; font-size: 13px; line-height: 1.4; overflow-wrap: anywhere; }
  .inv .equipo-datos .equipo-ubicacion { grid-column: auto; }
  .inv .equipo-datos .equipo-serie { font-weight: 600; }
  @media (max-width: 900px) { .inv .equipo-datos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) {
    .inv .equipo-datos { grid-template-columns: minmax(0, 1fr); }
    .inv .equipo-datos .equipo-ubicacion { grid-column: auto; }
    .inv .equipo-cabecera { flex-wrap: wrap; }
  }
</style>
<section>
  <div class="equipo-cabecera">
    <h2><%= equipo.producto.nombre %></h2>
    <%- include('accionesRegistro', { tipoRegistro: 'equipo', registro: equipo }) %>
  </div>
  <dl class="equipo-datos">
    <div><dt>Código de producto</dt><dd><%= equipo.producto.codigo %></dd></div>
    <div><dt>Marca</dt><dd><%= equipo.producto.marca || 'No informada' %></dd></div>
    <div><dt>Modelo</dt><dd><%= equipo.producto.modelo || 'No informado' %></dd></div>
    <div><dt>Serie</dt><dd class="equipo-serie"><%= equipo.serie %></dd></div>
    <div><dt>MAC</dt><dd><%= equipo.mac || '—' %></dd></div>
    <div><dt>Patrimonio</dt><dd><%= equipo.patrimonio || '—' %></dd></div>
    <div class="equipo-ubicacion"><dt><%= ['pendiente_baja', 'baja'].includes(equipo.estado) ? 'Última ubicación conocida' : 'Ubicación actual' %></dt><dd>
      <a href="/inventario/ubicaciones/<%= equipo.lugar._id %>"><%= equipo.lugar.nombre %></a>
    </dd></div>
    <div><dt>Estado</dt><dd><span class="state"><%= ({ disponible: 'Disponible', revision: 'A revisar', asignado: 'Asignado', produccion: 'En producción', pendiente_baja: 'Pendiente de baja', baja: 'Dado de baja' })[equipo.estado] || equipo.estado %></span></dd></div>
  </dl>
  <% if (permisos.informarBajas && (['disponible', 'revision'].includes(equipo.estado) ? equipo.lugar?.tipo === 'deposito' : ['asignado', 'produccion'].includes(equipo.estado) && equipo.asignacion)) { %>
    <div class="actions"><a class="button secondary" href="/inventario/bajas/nueva?equipo=<%= equipo._id %>">Registrar pérdida o sustracción</a></div>
  <% } %>
</section>

<section>
  <h2>Historial del equipo</h2>
  <div class="scroll">
    <table class="equipo-historial">
      <thead>
        <tr><th class="evento-numero" scope="col">N.°</th><th>Fecha</th><th>Evento</th><th>Estado resultante</th><th>Origen</th><th>Destino</th><th>Comprobante / responsable</th></tr>
      </thead>
      <tbody>
        <% for (const evento of eventos) { %>
          <tr>
            <td class="evento-numero"><%= evento.numero %></td>
            <td><%= new Date(evento.fecha).toLocaleDateString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires' }) %></td>
            <td><%= evento.operacion %></td>
            <td><%= evento.estado || '—' %></td>
            <td><%= evento.origen || '—' %></td>
            <td><%= evento.destino || '—' %></td>
            <td><% if (evento.url) { %><a href="<%= evento.url %>"><%= evento.referencia %></a><% } else { %><%= evento.referencia || '—' %><% } %></td>
          </tr>
        <% } %>
        <% if (!eventos.length) { %><tr><td colspan="7">Todavía no hay eventos registrados.</td></tr><% } %>
      </tbody>
    </table>
  </div>
  <%- include('paginacion', { base: '/inventario/equipos/' + equipo._id, filtros: {} }) %>
</section>
