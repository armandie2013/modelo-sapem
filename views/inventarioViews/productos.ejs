<style>
  .inv .productos-table {
    width: 100%;
    table-layout: auto;
    font-size: 13px;
    line-height: 1.4;
  }

  .inv .productos-table th {
    font-size: 12px;
  }

  .inv .productos-table td {
    padding-top: 9px;
    padding-bottom: 9px;
  }

  .inv .productos-table .col-codigo {
    width: 90px;
    min-width: 90px;
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
  }

  .inv .productos-table .product-name {
    min-width: 220px;
    max-width: 400px;
    overflow-wrap: anywhere;
  }

  .inv .productos-table .description {
    min-width: 180px;
    max-width: 300px;
  }

  .inv .productos-table .col-control {
    min-width: 110px;
  }

  .inv .catalogo-busqueda {
    display: flex;
    align-items: end;
    gap: 8px;
    margin-bottom: 14px;
  }

  .inv .catalogo-busqueda label {
    flex: 1;
    max-width: 550px;
    margin: 0;
  }

  .inv .catalogo-busqueda button {
    margin-bottom: 0;
  }
</style>

<section>
  <div class="list-heading">
    <p class="muted">
      Catálogo de productos.
      Crear o editar una ficha no modifica las existencias.
      El material ingresa únicamente con un documento de respaldo.
    </p>

    <% if (permisos.administrar) { %>
      <div class="actions">
        <a class="button" href="/inventario/productos/nuevo">
          Nuevo producto
        </a>
      </div>
    <% } %>
  </div>

  <div class="catalogo-busqueda">
    <label>
      Buscar producto
      <input
        id="buscarCatalogo"
        type="search"
        placeholder="Código, nombre, marca, modelo o descripción"
        autocomplete="off"
      >
    </label>

    <button type="button" id="limpiarCatalogo" class="secondary">
      Limpiar
    </button>
  </div>

  <div class="scroll">
    <table class="list-table productos-table">
      <thead>
        <tr>
          <th class="col-codigo">Código</th>
          <th>Nombre</th>
          <th>Marca / modelo</th>
          <th>Descripción</th>
          <th class="col-control">Control</th>
          <th>Estado</th>
          <th class="col-actions">Acciones</th>
        </tr>
      </thead>

      <tbody>
        <% productos.forEach(producto => { %>
          <tr data-fila-producto>
            <td class="col-codigo"><%= producto.codigo %></td>

            <td class="product-name">
              <span class="cell-title"><%= producto.nombre %></span>
            </td>

            <td>
              <%= [producto.marca, producto.modelo]
                .filter(Boolean).join(' · ') || '—' %>
            </td>

            <td class="description">
              <%= producto.descripcion || '—' %>
            </td>

            <td class="col-control">
              <%= producto.serializado
                ? 'Por número de serie'
                : 'Por cantidad' %>
            </td>

            <td>
              <span class="state">
                <%= producto.activo === false ? 'Inactivo' : 'Activo' %>
              </span>
            </td>

            <td class="col-actions">
              <%- include('accionesListado', {
                tipoRegistro: 'producto',
                registro: producto
              }) %>
            </td>
          </tr>
        <% }); %>

        <tr id="catalogoVacio" <%= productos.length ? 'hidden' : '' %>>
          <td colspan="7" class="empty">
            No hay productos para mostrar.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="list-footer">
    <span id="catalogoContador" role="status">
      <%= productos.length %> productos
    </span>
  </div>
</section>

<script>
(() => {
  const input = document.querySelector('#buscarCatalogo');

  const filas = [
    ...document.querySelectorAll('[data-fila-producto]')
  ];

  const normalizar = valor =>
    String(valor || '')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toUpperCase();

  const textos = filas.map(fila =>
    normalizar(
      [...fila.cells]
        .slice(0, 4)
        .map(celda => celda.textContent)
        .join(' ')
    )
  );

  function filtrar() {
    const terminos = normalizar(input.value)
      .trim()
      .split(/\s+/)
      .filter(Boolean);

    let visibles = 0;

    filas.forEach((fila, indice) => {
      fila.hidden = !terminos.every(
        termino => textos[indice].includes(termino)
      );

      if (!fila.hidden) visibles++;
    });

    document.querySelector('#catalogoVacio').hidden =
      visibles > 0;

    document.querySelector('#catalogoContador').textContent =
      `${visibles} de ${filas.length} productos`;
  }

  input.addEventListener('input', filtrar);

  document.querySelector('#limpiarCatalogo').onclick = () => {
    input.value = '';
    filtrar();
    input.focus();
  };
})();
</script>