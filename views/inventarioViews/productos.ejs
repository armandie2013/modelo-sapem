<style>
  .inv .productos-table {
    width: 100%;
    table-layout: auto;
    font-size: 13px;
    line-height: 1.4;
  }

  .inv .productos-table th {
    font-size: 12px;
  }

  .inv .productos-table td {
    padding-top: 9px;
    padding-bottom: 9px;
  }

  .inv .productos-table .col-codigo {
    width: 90px;
    min-width: 90px;
    white-space: nowrap;
    overflow-wrap: normal;
    word-break: normal;
    font-variant-numeric: tabular-nums;
  }

  .inv .productos-table .product-name {
    min-width: 220px;
    max-width: 400px;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .inv .productos-table .description {
    min-width: 180px;
    max-width: 300px;
  }

  .inv .productos-table .col-control {
    min-width: 110px;
  }
</style>

<section>
  <div class="list-heading">
    <p class="muted">
      Catálogo de productos.
      Crear o editar una ficha no modifica las existencias.
      El material ingresa únicamente con un documento de respaldo.
    </p>

    <% if (permisos.administrar) { %>
      <div class="actions">
        <a
          class="button"
          href="/inventario/productos/nuevo"
        >
          Nuevo producto
        </a>
      </div>
    <% } %>
  </div>

  <div class="scroll">
    <table class="list-table productos-table">
      <thead>
        <tr>
          <th class="col-codigo">Código</th>
          <th>Nombre</th>
          <th>Marca / modelo</th>
          <th>Descripción</th>
          <th class="col-control">Control</th>
          <th>Estado</th>
          <th class="col-actions">Acciones</th>
        </tr>
      </thead>

      <tbody>
        <% productos.forEach(producto => { %>
          <tr>
            <td class="col-codigo">
              <%= producto.codigo %>
            </td>

            <td class="product-name">
              <span class="cell-title">
                <%= producto.nombre %>
              </span>
            </td>

            <td>
              <%=
                [producto.marca, producto.modelo]
                  .filter(Boolean)
                  .join(' · ') || '—'
              %>
            </td>

            <td class="description">
              <%= producto.descripcion || '—' %>
            </td>

            <td class="col-control">
              <%= producto.serializado
                ? 'Por número de serie'
                : 'Por cantidad'
              %>
            </td>

            <td>
              <span class="state">
                <%= producto.activo === false
                  ? 'Inactivo'
                  : 'Activo'
                %>
              </span>
            </td>

            <td class="col-actions">
              <%- include('accionesListado', {
                tipoRegistro: 'producto',
                registro: producto
              }) %>
            </td>
          </tr>
        <% }); %>

        <% if (!productos.length) { %>
          <tr>
            <td colspan="7" class="empty">
              Todavía no hay productos.
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <div class="list-footer">
    <span>
      <%= productos.length %>
      <%= productos.length === 1 ? 'producto' : 'productos' %>
    </span>
  </div>
</section>