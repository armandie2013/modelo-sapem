<style>
  .gestion-comprobante { font-size: 13px; line-height: 1.45; }
  .gestion-comprobante .web { padding: 14px; border-radius: 7px; margin: 12px 0; }
  .gestion-comprobante h2 { font-size: 15px; margin: 0; }
  .gestion-comprobante .cabecera { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .gestion-comprobante .contador { background: #dbeafe; color: #1e40af; padding: 2px 8px; border-radius: 12px; font-size: 12px; }
  .gestion-comprobante .muted { color: #64748b; font-size: 12px; margin: 5px 0; }
  .gestion-comprobante .archivo { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 10px; border: 1px solid #cbd5e1; border-radius: 5px; background: white; margin: 6px 0; }
  .gestion-comprobante .archivo-nombre { color: #1e40af; overflow-wrap: anywhere; min-width: 0; }
  .gestion-comprobante .acciones { display: flex; gap: 6px; flex-shrink: 0; }
  .gestion-comprobante .boton, .gestion-comprobante button { display: inline-flex; align-items: center; justify-content: center; padding: 6px 10px; min-height: 30px; border: 1px solid transparent; border-radius: 5px; background: #1e40af; color: white; font: inherit; font-size: 12px; text-decoration: none; cursor: pointer; margin: 0; }
  .gestion-comprobante .secondary { background: white; color: #172033; border-color: #cbd5e1; }
  .gestion-comprobante .subir { border-top: 1px solid #cbd5e1; margin-top: 12px; padding-top: 10px; }
  .gestion-comprobante label { display: flex; flex-direction: column; gap: 5px; font-size: 12px; min-width: 0; }
  .gestion-comprobante input, .gestion-comprobante select, .gestion-comprobante textarea { width: 100%; min-width: 0; border: 1px solid #cbd5e1; border-radius: 4px; background: white; padding: 7px 8px; font: inherit; color: #172033; }
  .gestion-comprobante input[type=file] { padding: 5px; font-size: 12px; }
  .gestion-comprobante input::file-selector-button { border: 1px solid #cbd5e1; border-radius: 4px; padding: 4px 8px; background: #fff; color: #172033; margin-right: 8px; cursor: pointer; }
  .gestion-comprobante .campos { display: grid; grid-template-columns: 120px 1fr 155px 1.4fr; gap: 12px; margin-top: 12px; }
  .gestion-comprobante .pie-formulario { display: flex; align-items: end; justify-content: space-between; gap: 12px; }
  .gestion-comprobante .pie-formulario > div { flex: 1; min-width: 0; }
  .gestion-comprobante .peligro { border: 1px solid #efb4b4; background: white; }
  .gestion-comprobante .peligro h2 { color: #b91c1c; }
  .gestion-comprobante summary { cursor: pointer; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 4px; background: #f8fafc; font-weight: 600; margin-top: 10px; }
  .gestion-comprobante details form { margin-top: 12px; }
  .gestion-comprobante .peligro button { background: #b91c1c; margin-top: 8px; }
  .gestion-comprobante a:focus-visible, .gestion-comprobante button:focus-visible, .gestion-comprobante summary:focus-visible { outline: 2px solid #1e40af; outline-offset: 2px; }
  @media (max-width: 700px) {
    .gestion-comprobante .campos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gestion-comprobante .pie-formulario { align-items: stretch; flex-direction: column; }
    .gestion-comprobante .archivo { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 420px) { .gestion-comprobante .campos { grid-template-columns: minmax(0, 1fr); } }
  @media print { .gestion-comprobante { display: none !important; } }
</style>

<div class="gestion-comprobante">
  <section class="web">
    <div class="cabecera">
      <h2>Archivos adjuntos</h2>
      <span class="contador"><%= archivos.length %> <%= archivos.length === 1 ? 'archivo' : 'archivos' %></span>
    </div>

    <% archivos.forEach(adjunto => { %>
      <div class="archivo">
        <span class="archivo-nombre"><%= adjunto.nombre %></span>
        <div class="acciones">
          <a class="boton secondary" href="/inventario/archivos/<%= adjunto._id %>?ver=1" target="_blank" rel="noopener noreferrer" aria-label="Ver <%= adjunto.nombre %>">Ver</a>
          <a class="boton secondary" href="/inventario/archivos/<%= adjunto._id %>" aria-label="Descargar <%= adjunto.nombre %>">Descargar</a>
        </div>
      </div>
    <% }); %>
    <% if (!archivos.length) { %><p class="muted">No hay archivos adjuntos.</p><% } %>

    <% if (permisos[accion]) { %>
      <form class="subir pie-formulario" method="post" action="/inventario/movimientos/<%= mov._id %>/adjuntos" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div>
          <label>Agregar copia firmada u otros adjuntos
            <input name="archivos" type="file" multiple required accept="application/pdf,image/png,image/jpeg">
          </label>
          <p class="muted">Hasta 3 archivos por envío · 10 MB por archivo.</p>
        </div>
        <button type="submit">Guardar adjuntos</button>
      </form>
    <% } %>
  </section>

  <% if (mov.estado !== 'anulado' && mov.tipo === 'ingreso' && permisos.ingresar) { %>
    <section class="web">
      <h2>Agregar documento al ingreso</h2>
      <p class="muted">Esta operación no modifica el stock.</p>
      <form method="post" action="/inventario/movimientos/<%= mov._id %>/documentos" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="campos">
          <label>Tipo
            <select name="documentoTipo">
              <% ['remito', 'factura', 'nota', 'acta', 'otro'].forEach(tipo => { %>
                <option value="<%= tipo %>"><%= tipo.charAt(0).toUpperCase() + tipo.slice(1) %></option>
              <% }); %>
            </select>
          </label>
          <label>Número<input name="documentoNumero" required maxlength="100" placeholder="Ej. 0003-00155726"></label>
          <label>Fecha<input name="documentoFecha" type="date" value="<%= hoy %>" required></label>
          <label>Emisor / proveedor<input name="emisor" required maxlength="180" placeholder="Nombre del proveedor"></label>
        </div>
        <div class="subir pie-formulario">
          <div>
            <label>Adjuntos opcionales<input name="archivos" type="file" multiple accept="application/pdf,image/png,image/jpeg"></label>
            <p class="muted">Hasta 3 archivos por envío · 10 MB por archivo.</p>
          </div>
          <button type="submit">Agregar documento</button>
        </div>
      </form>
    </section>
  <% } %>

  <% if (mov.estado !== 'anulado' && ['asignacion', 'produccion'].includes(mov.tipo) && mov.items.some(item => item.cantidad > item.devuelto) && permisos.devolver) { %>
    <section class="web">
      <a class="boton" href="/inventario/<%= mov.tipo === 'produccion' ? 'produccion' : 'asignaciones' %>/<%= mov._id %>/devolucion">Registrar devolución</a>
    </section>
  <% } %>

  <% if (permisos.anular && mov.estado !== 'anulado') { %>
    <section class="web peligro">
      <h2>Anular movimiento</h2>
      <p class="muted">Revierte las existencias y conserva el comprobante.</p>
      <details>
        <summary>Mostrar opciones de anulación</summary>
        <form method="post" action="/inventario/movimientos/<%= mov._id %>/anular" onsubmit="return confirm('¿Confirmás la anulación y la reversión del stock?')">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Motivo<textarea name="motivo" required minlength="5" maxlength="2000" rows="3"></textarea></label>
          <button type="submit">Anular movimiento</button>
        </form>
      </details>
      <p class="muted">Si hay operaciones posteriores relacionadas, primero deben anularse.</p>
    </section>
  <% } %>
</div>
