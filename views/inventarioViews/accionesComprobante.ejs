<%- include('estilosGestionComprobante') %>


<div class="gestion-comprobante">
  <%- include('adjuntosComprobante', { puedeAdjuntar: permisos[accion], rutaAdjuntos: '/inventario/movimientos/' + mov._id + '/adjuntos' }) %>

  <% if (mov.estado !== 'anulado' && mov.tipo === 'ingreso' && permisos.ingresar) { %>
    <section class="web">
      <h2>Agregar documento al ingreso</h2>
      <p class="muted">Esta operación no modifica el stock.</p>
      <form method="post" action="/inventario/movimientos/<%= mov._id %>/documentos" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="campos">
          <label>Tipo
            <select name="documentoTipo">
              <% ['remito', 'factura', 'nota', 'acta', 'otro'].forEach(tipo => { %>
                <option value="<%= tipo %>"><%= tipo.charAt(0).toUpperCase() + tipo.slice(1) %></option>
              <% }); %>
            </select>
          </label>
          <label>Número<input name="documentoNumero" required maxlength="100" placeholder="Ej. 0003-00155726"></label>
          <label>Fecha<input name="documentoFecha" type="date" value="<%= hoy %>" required></label>
          <label>Emisor / proveedor<input name="emisor" required maxlength="180" placeholder="Nombre del proveedor"></label>
        </div>
        <div class="subir pie-formulario">
          <div>
            <label>Adjuntos opcionales<input name="archivos" type="file" multiple accept="application/pdf,image/png,image/jpeg"></label>
            <p class="muted">Hasta 3 archivos por envío · 10 MB por archivo.</p>
          </div>
          <button type="submit">Agregar documento</button>
        </div>
      </form>
    </section>
  <% } %>

  <% if (mov.estado !== 'anulado' && ['asignacion', 'produccion'].includes(mov.tipo) && permisos.informarBajas && mov.items.some(item => item.serializado && item.cantidad > (item.devuelto || 0) + (item.retirado || 0))) { %>
    <section class="web"><a class="boton" href="/inventario/bajas/nueva?movimiento=<%= mov._id %>">Registrar pérdida o sustracción</a></section>
  <% } %>
  <% if (mov.estado !== 'anulado' && ['asignacion', 'produccion'].includes(mov.tipo) && mov.items.some(item => item.cantidad > item.devuelto + (item.retirado || 0)) && permisos.devolver) { %>
    <section class="web">
      <a class="boton" href="/inventario/<%= mov.tipo === 'produccion' ? 'produccion' : 'asignaciones' %>/<%= mov._id %>/devolucion">Registrar devolución</a>
    </section>
  <% } %>

  <% if (permisos.anular && mov.estado !== 'anulado' && !mov.items.some(item => item.retirado)) { %>
    <section class="web peligro">
      <h2>Anular movimiento</h2>
      <p class="muted">Revierte las existencias y conserva el comprobante.</p>
      <details>
        <summary>Mostrar opciones de anulación</summary>
        <form method="post" action="/inventario/movimientos/<%= mov._id %>/anular" onsubmit="return confirm('¿Confirmás la anulación y la reversión del stock?')">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label>Motivo<textarea name="motivo" required minlength="5" maxlength="2000" rows="3"></textarea></label>
          <button type="submit">Anular movimiento</button>
        </form>
      </details>
      <p class="muted">Si hay operaciones posteriores relacionadas, primero deben anularse.</p>
    </section>
  <% } %>
</div>
