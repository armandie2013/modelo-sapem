  <style>
    * {
      box-sizing: border-box;
    }

    body {
      font: 11px/1.3 Arial, sans-serif;
      color: #172033;
      margin: 20px auto;
      max-width: 1000px;
      padding: 0 16px;
    }

    header {
      border-bottom: 1.5px solid #1e40af;
      padding-bottom: 9px;
      margin-bottom: 10px;
      break-inside: avoid;
    }

    header img {
      display: block;
      width: 195px;
      max-width: 100%;
      height: auto;
      max-height: 54px;
      object-fit: contain;
    }

    h1 {
      font-size: 20px;
      line-height: 1.2;
      margin: 0 0 5px;
    }

    h2 {
      font-size: 12px;
      margin: 10px 0 5px;
      break-after: avoid;
      page-break-after: avoid;
    }

    p {
      margin: 0 0 5px;
      overflow-wrap: anywhere;
    }

    table {
      border-collapse: collapse;
      width: 100%;
      margin: 0 0 7px;
    }

    th,
    td {
      border: .5px solid #cbd5e1;
      padding: 4px 5px;
      text-align: left;
      vertical-align: top;
    }

    th {
      background: #eff6ff;
      font-weight: 700;
    }

    thead {
      display: table-header-group;
    }

    tr {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .doc-header {
      margin: 0;
      table-layout: fixed;
    }

    .doc-header td {
      border: 0;
      padding: 0;
      vertical-align: middle;
    }

    .doc-header td:first-child {
      width: 40%;
    }

    .doc-header .doc-title {
      text-align: right;
    }

    .doc-number {
      font-size: 11px;
    }

    .doc-date {
      color: #64748b;
    }

    .partes {
      table-layout: fixed;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .partes td {
      width: 50%;
      padding: 7px 8px;
      overflow-wrap: anywhere;
    }

    .etiqueta {
      display: block;
      font-size: 9px;
      font-weight: 700;
      color: #64748b;
      margin-bottom: 2px;
    }

    .partes p {
      margin: 0 0 2px;
    }

    .materiales {
      width: 100%;
      table-layout: auto;
      font-size: 10px;
      line-height: 1.25;
    }

    .materiales th {
      white-space: nowrap;
    }

    .materiales th:nth-child(1),
    .materiales td:nth-child(1),
    .materiales th:nth-child(3),
    .materiales td:nth-child(3),
    .materiales th:nth-child(5),
    .materiales td:nth-child(5),
    .materiales th:nth-child(6),
    .materiales td:nth-child(6) {
      width: 1%;
      white-space: nowrap;
      overflow-wrap: normal;
      word-break: normal;
    }

    .materiales td:nth-child(2) {
      min-width: 110px;
      max-width: 270px;
      overflow-wrap: anywhere;
    }

    .materiales td:nth-child(4) {
      min-width: 85px;
      max-width: 180px;
      overflow-wrap: anywhere;
    }

    .numeric {
      text-align: right;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }

    .nota-series,
    .aviso-historico {
      font-size: 9px;
      color: #64748b;
    }

    .series-table {
      table-layout: fixed;
      margin: 0 0 5px;
      font-size: 10px;
    }

    .series-table th {
      padding: 3px 5px;
      font-weight: 400;
    }

    .series-heading {
      display: flex;
      justify-content: space-between;
      gap: 10px;
    }

    .series-heading span:first-child {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .series-count {
      white-space: nowrap;
      flex-shrink: 0;
    }

    .series-table td {
      padding: 2px 6px;
      overflow-wrap: anywhere;
    }

    .serie-valor {
      font-family: 'Courier New', monospace;
      font-size: 10px;
    }

    .equipo-meta {
      display: block;
      font-size: 8px;
      line-height: 1.3;
      margin-top: 2px;
      color: #475569;
    }

    .series-table .vacia {
      background: #fafbfc;
    }

    .cierre {
      margin-top: 7px;
    }

    .cierre p {
      margin-bottom: 4px;
    }

    .observaciones {
      white-space: pre-wrap;
    }

    .firmas {
      table-layout: fixed;
      margin-top: 14mm;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .firmas td {
      width: 50%;
      border: 0;
      padding: 0 12px 0 0;
    }

    .firmas td + td {
      padding: 0 0 0 12px;
    }

    .firma-linea {
      border-top: .6px solid #172033;
      padding-top: 5px;
    }

    .firmas.ingreso td {
      width: 100%;
      padding: 0;
    }

    .firmas.ingreso .firma-linea {
      max-width: 320px;
    }

    .web {
      background: #f1f5f9;
      border-radius: 7px;
      padding: 14px;
      margin: 16px 0;
    }

    .web h2 {
      margin-top: 0;
    }

    .web-toolbar {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    label {
      display: block;
      margin: 10px 0;
    }

    input,
    select,
    textarea {
      padding: 7px;
      max-width: 100%;
      font: inherit;
    }

    button,
    .boton {
      display: inline-block;
      padding: 7px 11px;
      background: #1e40af;
      color: white;
      border: 0;
      border-radius: 5px;
      text-decoration: none;
      font: inherit;
      cursor: pointer;
    }

    .boton.secondary {
      background: #e2e8f0;
      color: #334155;
    }

    .anulado {
      border: 1.5px solid #b91c1c;
      color: #991b1b;
      padding: 10px;
      margin: 10px 0;
      break-inside: avoid;
    }

    @media print {
      .web {
        display: none !important;
      }

      body {
        font-size: 8pt;
        margin: 0;
        padding: 0;
        max-width: none;
      }

      h1 {
        font-size: 16pt;
      }

      h2 {
        font-size: 9pt;
        margin-top: 8px;
      }

      .materiales {
        font-size: 7.5pt;
      }

      .materiales th,
      .materiales td {
        padding: 3pt 4pt;
      }

      .series-table,
      .serie-valor {
        font-size: 8pt;
        line-height: 1.15;
      }

      .series-table td {
        padding: 1.5pt 4pt;
      }

      .equipo-meta {
        font-size: 6.5pt;
      }

      .nota-series,
      .aviso-historico {
        font-size: 7pt;
      }

      .etiqueta {
        font-size: 7pt;
      }

      .firmas {
        margin-top: 10mm;
      }
    }

    @media screen and (max-width: 640px) {
      body {
        padding: 0 10px;
      }

      .doc-header td {
        display: block;
        width: 100% !important;
      }

      .doc-header .doc-title {
        text-align: left;
        padding-top: 10px;
      }

      .material-scroll {
        overflow-x: auto;
      }

      .materiales {
        min-width: 660px;
      }
    }
  </style>
