<%
  const fmtUSD = valor => 'US$ ' + Number(valor || 0).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const permisosPlanes = usuario?.modulosPermitidos?.planes || {};
  const filtroBusqueda = typeof busqueda === 'string' ? busqueda : '';
  const filtroEstado = typeof estado === 'string' ? estado : 'todos';
  const listaPlanes = Array.isArray(planes) ? planes : [];
%>
<style>
  .planes-page { max-width: 1280px; margin: 0 auto; }
  .planes-page .planes-card { background: #fff; border: 1px solid #dbe3ef; border-radius: 8px; padding: 18px; }
  .planes-page .planes-heading { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
  .planes-page h1 { font-size: 24px; font-weight: 700; margin: 0; }
  .planes-page .muted { color: #64748b; font-size: 13px; }
  .planes-page .planes-button { display: inline-flex; align-items: center; padding: 7px 12px; border-radius: 5px; background: #1e40af; color: white; font-size: 13px; text-decoration: none; white-space: nowrap; }
  .planes-page .planes-filtros { display: flex; align-items: flex-end; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
  .planes-page .planes-filtros label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .planes-page .planes-search { flex: 1 1 280px; }
  .planes-page .planes-filtros input, .planes-page .planes-filtros select { min-height: 34px; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 5px; background: white; font: inherit; }
  .planes-page .planes-filtros .planes-button { min-height: 34px; border: 0; cursor: pointer; }
  .planes-page .planes-filtros .secondary { background: #e2e8f0; color: #172033; }
  .planes-page .planes-scroll { overflow-x: auto; }
  .planes-page table { width: 100%; min-width: 680px; border-collapse: collapse; table-layout: auto; font-size: 13px; }
  .planes-page th, .planes-page td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #e2e8f0; vertical-align: middle; }
  .planes-page th { background: #eff6ff; font-weight: 600; }
  .planes-page .planes-name { min-width: 190px; max-width: 300px; font-weight: 500; overflow-wrap: anywhere; }
  .planes-page .planes-detail { min-width: 240px; max-width: 550px; overflow-wrap: anywhere; }
  .planes-page .planes-amount { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .planes-page .planes-state, .planes-page .planes-actions { width: 1%; white-space: nowrap; }
  .planes-page tbody tr:nth-child(even) { background: #f8fafc; }
  .planes-page tbody tr:hover { background: #eff6ff; }
  .planes-page .planes-state span { display: inline-flex; align-items: center; justify-content: center; min-width: 64px; border-radius: 4px; padding: 3px 7px; font-size: 12px; background: #f1f5f9; color: #475569; }
  .planes-page .planes-state .activo { background: #dcfce7; color: #166534; }
  .planes-page .planes-state .inactivo { background: #fee2e2; color: #991b1b; }
  .planes-page td a { color: #1e40af; }
  .planes-page td a:hover { text-decoration: underline; }
  .planes-page .planes-footer { margin-top: 12px; font-size: 12px; color: #64748b; }
  @media (max-width: 640px) { .planes-page .planes-card { padding: 12px; } }
</style>
<div class="planes-page">
  <section class="planes-card">
    <div class="planes-heading">
      <div><h1>Planes</h1><p class="muted">Administrá los planes existentes.</p></div>
      <% if (permisosPlanes.crear) { %><a href="/planes/crear" class="planes-button">Crear plan</a><% } %>
    </div>
    <form class="planes-filtros" method="get" action="/planes">
      <label class="planes-search" for="planesBuscar">Buscar plan
        <input id="planesBuscar" type="search" name="q" placeholder="Nombre o detalle" value="<%= filtroBusqueda %>">
      </label>
      <label for="planesEstado">Estado
        <select id="planesEstado" name="estado">
          <% for (const [valor, etiqueta] of Object.entries({ todos: 'Todos', activos: 'Activos', inactivos: 'Inactivos' })) { %>
            <option value="<%= valor %>" <%= filtroEstado === valor ? 'selected' : '' %>><%= etiqueta %></option>
          <% } %>
        </select>
      </label>
      <button class="planes-button" type="submit">Filtrar</button>
      <a class="planes-button secondary" href="/planes">Limpiar</a>
    </form>
    <div class="planes-scroll">
      <table>
        <thead><tr><th>Nombre</th><th>Detalle</th><th class="planes-amount">Importe</th><th class="planes-state">Estado</th><th class="planes-actions">Acciones</th></tr></thead>
        <tbody>
          <% for (const plan of listaPlanes) { %>
            <tr>
              <td class="planes-name"><a href="/planes/<%= plan._id %>"><%= plan.nombre %></a></td>
              <td class="planes-detail"><%= plan.detalle || '—' %></td>
              <td class="planes-amount"><%= fmtUSD(plan.importe) %></td>
              <td class="planes-state"><span class="<%= plan.activo === false ? 'inactivo' : 'activo' %>"><%= plan.activo === false ? 'Inactivo' : 'Activo' %></span></td>
              <td class="planes-actions"><% if (permisosPlanes.editar) { %><a href="/planes/<%= plan._id %>/editar">Editar</a><% } else { %>—<% } %></td>
            </tr>
          <% } %>
          <% if (!listaPlanes.length) { %><tr><td colspan="5" class="muted">No hay planes que coincidan con la búsqueda.</td></tr><% } %>
        </tbody>
      </table>
    </div>
    <p class="planes-footer"><%= listaPlanes.length %> <%= listaPlanes.length === 1 ? 'plan' : 'planes' %></p>
  </section>
</div>
