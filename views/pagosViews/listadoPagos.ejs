<main class="bg-gray-100 min-h-screen py-8 px-4">
  <%
    const fmtUSD = (valor) => {
      return new Intl.NumberFormat('es-AR', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(Number(valor || 0));
    };

    const fmtFechaFiltro = (valor) => {
      const texto =
        String(valor || '').trim();

      const match =
        texto.match(
          /^(\d{4})-(\d{2})-(\d{2})$/
        );

      return match
        ? `${match[3]}/${match[2]}/${match[1]}`
        : '';
    };

    const fmtFechaPago = (valor) => {
      if (!valor) {
        return '—';
      }

      const fecha =
        new Date(valor);

      if (
        Number.isNaN(
          fecha.getTime()
        )
      ) {
        return '—';
      }

      return fecha.toLocaleDateString(
        'es-AR',
        {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric'
        }
      );
    };

    const pagosArr =
      pagos || [];

    const totalPagos =
      pagosArr.length;

    const totalImporte =
      pagosArr.reduce(
        (acc, pago) =>
          acc +
          Number(
            pago.importe || 0
          ),
        0
      );

    const desdeTexto =
      fmtFechaFiltro(
        filtros?.desde
      );

    const hastaTexto =
      fmtFechaFiltro(
        filtros?.hasta
      );

    let rangoTxt =
      'Todo';

    if (
      desdeTexto &&
      hastaTexto
    ) {
      rangoTxt =
        `${desdeTexto} → ${hastaTexto}`;
    } else if (desdeTexto) {
      rangoTxt =
        `Desde ${desdeTexto}`;
    } else if (hastaTexto) {
      rangoTxt =
        `Hasta ${hastaTexto}`;
    }

    const medioBadge = (medio) => {
      const texto =
        String(medio || '')
          .toLowerCase();

      if (
        texto.includes('trans')
      ) {
        return 'bg-sky-100 text-sky-800 border border-sky-200';
      }

      if (
        texto.includes('efec')
      ) {
        return 'bg-emerald-100 text-emerald-800 border border-emerald-200';
      }

      if (
        texto.includes('tarj')
      ) {
        return 'bg-indigo-100 text-indigo-800 border border-indigo-200';
      }

      if (
        texto.includes('cheq')
      ) {
        return 'bg-amber-100 text-amber-800 border border-amber-200';
      }

      return 'bg-gray-100 text-gray-800 border border-gray-200';
    };
  %>

  <style>
    .break-anywhere {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .toast-wrap {
      position: fixed;
      inset-inline: 0;
      top: 16px;
      display: flex;
      justify-content: center;
      z-index: 60;
      pointer-events: none;
    }

    .toast {
      pointer-events: auto;
      min-width: 260px;
      max-width: 92vw;
      background: white;
      border: 1px solid rgba(0, 0, 0, .08);
      box-shadow: 0 10px 20px rgba(0, 0, 0, .12);
      border-radius: 12px;
      padding: 10px 12px;
      display: flex;
      gap: 10px;
      align-items: center;
      transform: translateY(-10px);
      opacity: 0;
      transition: all .2s ease;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .toast .msg {
      font-size: .9rem;
      color: #1f2937;
    }

    .toast.success {
      border-color: rgba(16, 185, 129, .25);
    }

    .toast.error {
      border-color: rgba(239, 68, 68, .25);
    }

    .toast .icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 9999px;
    }

    .toast.success .icon {
      background: rgba(16, 185, 129, .12);
      color: #065f46;
    }

    .toast.error .icon {
      background: rgba(239, 68, 68, .12);
      color: #7f1d1d;
    }

    .toast .close {
      margin-left: 6px;
      font-size: 14px;
      color: #6b7280;
      background: transparent;
      border: 0;
      cursor: pointer;
    }
  </style>

  <div
    id="pagos-root"
    data-total-pagos="<%= totalPagos %>"
    class="max-w-7xl mx-auto bg-white p-6 md:p-8 rounded-2xl shadow-lg border border-gray-200"
  >
    <div
      class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between mb-6"
    >
      <div>
        <h1 class="text-2xl font-bold text-gray-900">
          Pagos
        </h1>

        <p class="text-sm text-gray-500">
          Gestión y seguimiento de pagos de clientes
        </p>
      </div>

      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2"
      >
        <button
          type="button"
          id="btnGenerarPdf"
          class="inline-flex items-center justify-center gap-2 bg-white text-gray-800 px-4 py-2 rounded-lg hover:bg-gray-50 transition text-sm shadow-sm border border-gray-300"
        >
          <svg
            class="w-4 h-4"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M5 2.75A1.75 1.75 0 016.75 1h6.5A1.75 1.75 0 0115 2.75V6h.25A2.75 2.75 0 0118 8.75v5.5A2.75 2.75 0 0115.25 17H15v.25A1.75 1.75 0 0113.25 19h-6.5A1.75 1.75 0 015 17.25V17h-.25A2.75 2.75 0 012 14.25v-5.5A2.75 2.75 0 014.75 6H5V2.75zM7 3v4h6V3H7zm6 10H7v4h6v-4z"
            />
          </svg>

          Generar PDF
        </button>

        <a
          href="/pagos/registrar"
          class="inline-flex items-center justify-center bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-700 transition text-sm shadow-sm"
        >
          + Registrar pago
        </a>
      </div>
    </div>

    <div
      class="grid grid-cols-2 sm:grid-cols-3 gap-3 mb-5"
    >
      <div
        class="bg-gray-50 border border-gray-200 rounded-xl p-4"
      >
        <p class="text-xs text-gray-500">
          Pagos listados
        </p>

        <p
          id="kpiCantidad"
          class="text-xl font-semibold text-gray-900"
        >
          <%= totalPagos %>
        </p>
      </div>

      <div
        class="bg-gray-50 border border-gray-200 rounded-xl p-4"
      >
        <p class="text-xs text-gray-500">
          Importe total
        </p>

        <p
          id="kpiImporte"
          class="text-xl font-semibold text-gray-900"
        >
          <%= fmtUSD(totalImporte) %>
        </p>
      </div>

      <div
        class="bg-gray-50 border border-gray-200 rounded-xl p-4"
      >
        <p class="text-xs text-gray-500">
          Rango
        </p>

        <p class="text-sm font-medium text-gray-800">
          <%= rangoTxt %>
        </p>
      </div>
    </div>

    <form
      class="grid grid-cols-1 sm:grid-cols-5 gap-3 mb-4"
      method="GET"
      action="/pagos"
    >
      <div class="sm:col-span-2">
        <label class="block text-xs text-gray-600 mb-1">
          Cliente
        </label>

        <select
          name="proveedor"
          class="w-full border px-3 py-2 rounded-lg text-sm"
        >
          <option value="">
            Todos los clientes
          </option>

          <% (proveedores || []).forEach((pr) => { %>
            <option
              value="<%= pr._id %>"
              <%= (
                String(filtros?.proveedor || '') ===
                String(pr._id)
              ) ? 'selected' : '' %>
            >
              #<%= pr.numeroProveedor %> —
              <%= pr.nombreFantasia || pr.nombreReal %>
            </option>
          <% }) %>
        </select>
      </div>

      <div>
        <label class="block text-xs text-gray-600 mb-1">
          Desde
        </label>

        <input
          type="date"
          name="desde"
          value="<%= filtros?.desde || '' %>"
          class="w-full border px-3 py-2 rounded-lg text-sm"
        >
      </div>

      <div>
        <label class="block text-xs text-gray-600 mb-1">
          Hasta
        </label>

        <input
          type="date"
          name="hasta"
          value="<%= filtros?.hasta || '' %>"
          class="w-full border px-3 py-2 rounded-lg text-sm"
        >
      </div>

      <div class="flex items-end">
        <button
          type="submit"
          class="bg-gray-900 text-white px-3 py-2 rounded-lg text-sm w-full"
        >
          Filtrar
        </button>
      </div>

      <div class="sm:col-span-3">
        <label class="block text-xs text-gray-600 mb-1">
          Buscar
        </label>

        <input
          id="buscar"
          type="text"
          placeholder="Por cliente, medio, comprobante u observación…"
          class="w-full border px-3 py-2 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500"
        >
      </div>

      <div class="sm:col-span-2">
        <label class="block text-xs text-gray-600 mb-1">
          Orden
        </label>

        <select
          id="orden"
          class="w-full border px-3 py-2 rounded-lg text-sm"
        >
          <option value="fecha-desc">
            Fecha (recientes)
          </option>

          <option value="fecha-asc">
            Fecha (antiguos)
          </option>

          <option value="proveedor-asc">
            Cliente (A-Z)
          </option>

          <option value="proveedor-desc">
            Cliente (Z-A)
          </option>

          <option value="importe-desc">
            Importe (↓)
          </option>

          <option value="importe-asc">
            Importe (↑)
          </option>
        </select>
      </div>
    </form>

    <p
      id="resumen"
      class="text-xs text-gray-600 mb-3"
    >
      Mostrando
      <%= totalPagos %>
      /
      <%= totalPagos %>
    </p>

    <div
      class="hidden md:block rounded-xl border border-gray-200 overflow-x-auto"
    >
      <table class="min-w-full text-sm table-fixed">
        <colgroup>
          <col style="width: 8rem;">
          <col>
          <col style="width: 9rem;">
          <col style="width: 10rem;">
          <col style="width: 11rem;">
          <col>
          <col style="width: 9rem;">
        </colgroup>

        <thead class="bg-gray-50 text-gray-700">
          <tr>
            <th class="px-4 py-3 text-left">
              Fecha
            </th>

            <th class="px-4 py-3 text-left">
              Cliente
            </th>

            <th class="px-4 py-3 text-left">
              Medio
            </th>

            <th class="px-4 py-3 text-right">
              Importe
            </th>

            <th class="px-4 py-3 text-left">
              Comprobante
            </th>

            <th class="px-4 py-3 text-left">
              Detalle
            </th>

            <th class="px-4 py-3 text-right">
              Acciones
            </th>
          </tr>
        </thead>

        <tbody
          id="tbody"
          class="divide-y"
        >
          <% if (!pagosArr.length) { %>
            <tr>
              <td
                colspan="7"
                class="px-4 py-6 text-center text-gray-500"
              >
                Sin pagos.
              </td>
            </tr>
          <% } else { %>
            <% pagosArr.forEach((pago) => {
                 const proveedorTxt =
                   pago.proveedor?.nombreFantasia ||
                   pago.proveedor?.nombreReal ||
                   '—';

                 const medio =
                   pago.metodo ||
                   pago.medio ||
                   '—';

                 const filtroTxt =
                   `${proveedorTxt} ${medio} ${pago.comprobante || ''} ${pago.observacion || ''}`
                     .toLowerCase();
            %>
              <tr
                class="hover:bg-gray-50 fila"
                data-fecha="<%= new Date(pago.fecha).getTime() %>"
                data-proveedor="<%= proveedorTxt.toLowerCase() %>"
                data-importe="<%= Number(pago.importe || 0) %>"
                data-filtro="<%= filtroTxt %>"
              >
                <td class="px-4 py-3 whitespace-nowrap">
                  <%= fmtFechaPago(pago.fecha) %>
                </td>

                <td class="px-4 py-3">
                  <div class="max-w-[18rem] break-anywhere">
                    <%= proveedorTxt %>
                  </div>
                </td>

                <td class="px-4 py-3">
                  <span
                    class="inline-flex px-2 py-0.5 rounded-full text-[11px] font-medium <%= medioBadge(medio) %>"
                  >
                    <%= medio %>
                  </span>
                </td>

                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <%= fmtUSD(pago.importe) %>
                </td>

                <td class="px-4 py-3 break-anywhere">
                  <%= pago.comprobante || '—' %>
                </td>

                <td class="px-4 py-3 break-anywhere">
                  <%= pago.observacion || '—' %>
                </td>

                <td class="px-4 py-3 text-right">
                  <form
                    action="/pagos/<%= pago._id %>/eliminar"
                    method="POST"
                    onsubmit="return confirm('¿Eliminar pago?')"
                  >
                    <button
                      class="px-3 py-1.5 rounded bg-rose-600 text-white hover:bg-rose-700 text-xs"
                    >
                      Eliminar
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <div
      id="cards"
      class="md:hidden space-y-3 mt-3"
    >
      <% if (!pagosArr.length) { %>
        <div class="text-center text-gray-500 py-6">
          Sin pagos.
        </div>
      <% } else { %>
        <% pagosArr.forEach((pago) => {
             const proveedorTxt =
               pago.proveedor?.nombreFantasia ||
               pago.proveedor?.nombreReal ||
               '—';

             const medio =
               pago.metodo ||
               pago.medio ||
               '—';

             const filtroTxt =
               `${proveedorTxt} ${medio} ${pago.comprobante || ''} ${pago.observacion || ''}`
                 .toLowerCase();
        %>
          <div
            class="border border-gray-200 rounded-xl p-4 fila"
            data-fecha="<%= new Date(pago.fecha).getTime() %>"
            data-proveedor="<%= proveedorTxt.toLowerCase() %>"
            data-importe="<%= Number(pago.importe || 0) %>"
            data-filtro="<%= filtroTxt %>"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <div class="text-xs text-gray-500">
                  <%= fmtFechaPago(pago.fecha) %>
                </div>

                <div class="text-sm font-semibold text-gray-900 break-anywhere">
                  <%= proveedorTxt %>
                </div>

                <div class="text-xs text-gray-500 mt-1">
                  Comp.:
                  <%= pago.comprobante || '—' %>
                </div>
              </div>

              <span
                class="inline-flex px-2 py-0.5 rounded-full text-[11px] font-medium <%= medioBadge(medio) %>"
              >
                <%= medio %>
              </span>
            </div>

            <div class="grid grid-cols-2 gap-2 mt-3">
              <div class="bg-gray-50 border border-gray-200 rounded-lg p-2">
                <div class="text-[11px] text-gray-500">
                  Importe
                </div>

                <div class="text-sm font-semibold">
                  <%= fmtUSD(pago.importe) %>
                </div>
              </div>

              <div class="bg-gray-50 border border-gray-200 rounded-lg p-2">
                <div class="text-[11px] text-gray-500">
                  Detalle
                </div>

                <div class="text-xs break-anywhere">
                  <%= pago.observacion || '—' %>
                </div>
              </div>
            </div>

            <div class="flex justify-end mt-3">
              <form
                action="/pagos/<%= pago._id %>/eliminar"
                method="POST"
                onsubmit="return confirm('¿Eliminar pago?')"
              >
                <button
                  class="px-2.5 py-1.5 rounded bg-rose-600 text-white hover:bg-rose-700 text-xs"
                >
                  Eliminar
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div
    id="toastWrap"
    class="toast-wrap"
    aria-live="polite"
    data-ok="<%= (
      typeof toastOk !== 'undefined' &&
      toastOk
    ) ? toastOk : '' %>"
    data-err="<%= (
      typeof toastErr !== 'undefined' &&
      toastErr
    ) ? toastErr : '' %>"
  ></div>

  <script>
    (function () {
      const $ = (
        selector,
        context = document
      ) => context.querySelector(selector);

      const $$ = (
        selector,
        context = document
      ) => Array.from(
        context.querySelectorAll(selector)
      );

      const buscar =
        $('#buscar');

      const orden =
        $('#orden');

      const resumen =
        $('#resumen');

      const kpiCantidad =
        $('#kpiCantidad');

      const kpiImporte =
        $('#kpiImporte');

      const filasTabla =
        $$('#tbody .fila');

      const cardsMovil =
        $$('#cards .fila');

      const pagosRoot =
        document.getElementById('pagos-root');

      const totalServidor =
        Number(
          pagosRoot?.dataset.totalPagos || 0
        );

      const formatoUSD =
        new Intl.NumberFormat(
          'es-AR',
          {
            style: 'currency',
            currency: 'USD',
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }
        );

      function actualizarResumen() {
        const visibles =
          $$('#tbody .fila:not(.hidden)');

        const importe =
          visibles.reduce(
            (acc, fila) =>
              acc +
              Number(
                fila.dataset.importe ||
                0
              ),
            0
          );

        if (resumen) {
          resumen.textContent =
            `Mostrando ${visibles.length} / ${totalServidor}`;
        }

        if (kpiCantidad) {
          kpiCantidad.textContent =
            String(visibles.length);
        }

        if (kpiImporte) {
          kpiImporte.textContent =
            formatoUSD.format(
              importe
            );
        }
      }

      function filtrar() {
        const texto =
          String(
            buscar?.value ||
            ''
          )
            .trim()
            .toLowerCase();

        [
          ...filasTabla,
          ...cardsMovil
        ].forEach(
          (elemento) => {
            const coincide =
              String(
                elemento.dataset.filtro ||
                ''
              ).includes(texto);

            elemento.classList.toggle(
              'hidden',
              !coincide
            );
          }
        );

        actualizarResumen();
      }

      function comparar(
        a,
        b,
        campo
      ) {
        if (
          campo === 'fecha' ||
          campo === 'importe'
        ) {
          return (
            Number(
              a.dataset[campo] ||
              0
            ) -
            Number(
              b.dataset[campo] ||
              0
            )
          );
        }

        return String(
          a.dataset.proveedor ||
          ''
        ).localeCompare(
          String(
            b.dataset.proveedor ||
            ''
          ),
          'es',
          {
            sensitivity: 'base'
          }
        );
      }

      function ordenar() {
        const [
          campo,
          direccion
        ] = String(
          orden?.value ||
          'fecha-desc'
        ).split('-');

        const factor =
          direccion === 'desc'
            ? -1
            : 1;

        const tbody =
          $('#tbody');

        const cards =
          $('#cards');

        if (tbody) {
          $$('#tbody .fila')
            .sort(
              (a, b) =>
                comparar(
                  a,
                  b,
                  campo
                ) * factor
            )
            .forEach(
              (fila) =>
                tbody.appendChild(
                  fila
                )
            );
        }

        if (cards) {
          $$('#cards .fila')
            .sort(
              (a, b) =>
                comparar(
                  a,
                  b,
                  campo
                ) * factor
            )
            .forEach(
              (card) =>
                cards.appendChild(
                  card
                )
            );
        }

        filtrar();
      }

      const btnGenerarPdf =
        $('#btnGenerarPdf');

      btnGenerarPdf?.addEventListener(
        'click',
        () => {
          const params =
            new URLSearchParams(
              window.location.search
            );

          const texto =
            String(
              buscar?.value ||
              ''
            ).trim();

          if (texto) {
            params.set(
              'buscar',
              texto
            );
          } else {
            params.delete(
              'buscar'
            );
          }

          params.set(
            'orden',
            orden?.value ||
            'fecha-desc'
          );

          const query =
            params.toString();

          const urlPdf =
            query
              ? `/pagos/reporte/pdf?${query}`
              : '/pagos/reporte/pdf';

          window.open(
            urlPdf,
            '_blank',
            'noopener'
          );
        }
      );

      buscar?.addEventListener(
        'input',
        filtrar
      );

      orden?.addEventListener(
        'change',
        ordenar
      );

      ordenar();

      const toastWrap =
        $('#toastWrap');

      function showToast(
        msg,
        type = 'success',
        ms = 3000
      ) {
        if (
          !msg ||
          !toastWrap
        ) {
          return;
        }

        const el =
          document.createElement(
            'div'
          );

        el.className =
          `toast ${type}`;

        const icon =
          type === 'success'
            ? '✓'
            : '!';

        el.innerHTML = `
          <div class="icon">
            ${icon}
          </div>

          <div class="msg"></div>

          <button
            type="button"
            class="close"
            aria-label="Cerrar"
          >
            &times;
          </button>
        `;

        const messageElement =
          el.querySelector('.msg');

        if (messageElement) {
          messageElement.textContent =
            msg;
        }

        toastWrap.appendChild(
          el
        );

        requestAnimationFrame(
          () =>
            el.classList.add(
              'show'
            )
        );

        const remove = () => {
          el.classList.remove(
            'show'
          );

          setTimeout(
            () => el.remove(),
            180
          );
        };

        const timer =
          setTimeout(
            remove,
            ms
          );

        el
          .querySelector(
            '.close'
          )
          ?.addEventListener(
            'click',
            () => {
              clearTimeout(
                timer
              );

              remove();
            }
          );
      }

      if (
        toastWrap?.dataset.ok
      ) {
        showToast(
          toastWrap.dataset.ok,
          'success',
          3500
        );
      }

      if (
        toastWrap?.dataset.err
      ) {
        showToast(
          toastWrap.dataset.err,
          'error',
          6000
        );
      }
